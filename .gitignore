# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Virtual environments and local editor state
.venv/
.vscode/

# Local-only workspace
NOT_UNDER_VERSION_CONTROL/
Paper/

# Simulation outputs and generated media
OUTPUT/
*.png
*.gif

# Local notes, reports, and generated text files
*.txt
!requirements.txt
*.md
!README.md
!DATA/ANTENNA/README.md

# Generated satellite/ephemeris artifacts
gnssr_satID_*.tle
*.FFephem
*.e
*.bsp
!DATA/SKYFIELD_data/de421.bsp

# Generated shapefile sidecars and gridded derivatives
*.cpg
*.dbf
*.prj
*_gridded.*
*_gridded_m.*
*_gridded_deg.*

# Source shapefiles need their sidecars (attributes, projection, encoding)
!DATA/world_costline_data/10m_physical/ne_10m_*.cpg
!DATA/world_costline_data/10m_physical/ne_10m_*.dbf
!DATA/world_costline_data/10m_physical/ne_10m_*.prj

# Marine Regions data is not redistributed; users download it themselves (see README.md)
DATA/eez/
DATA/International_hydrographic_organization/

# Generated JSON artifacts
*.json

# Generated antenna-pattern caches
DATA/ANTENNA/antenna_patterns*/
data/ANTENNA/antenna_patterns*/

# Generated scenario data folders
autogenerated*/
Autogenerated*/
DATA/TLE_EPHEMIRIS/autogenerated/
data/TLE_EPHEMIRIS/autogenerated/
DATA/TLE_EPHEMIRIS_files/autogenerated/
data/TLE_EPHEMIRIS_files/autogenerated/
DATA/autogenerated_ship_trajectory/
data/autogenerated_ship_trajectory/

# Local backup files
*.bkp

# Sphinx documentation build output
docs/build/
docs/_build/

# Keep committed documentation assets that the global media/text/json ignores would otherwise drop.
# (Re-inclusion works because docs/ itself is not ignored; files under docs/build/ stay ignored.)
!docs/**/*.png
!docs/**/*.svg
!docs/**/*.md
!docs/**/*.json
