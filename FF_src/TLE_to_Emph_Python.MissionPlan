//perform bitwise or on two arrays, and return 
Define Procedure array_bitwise_or(Array in, Array out);
	Variable i;
	//Report in.Dimension, out.Dimension;
	If (in.Dimension == out.Dimension) then;
		For i=0 to in.Dimension-1;
			out[i] = out[i].Or(in[i]);
		End;
	End;
EndProcedure;

Define Procedure array_bitwise_and(Array in, Array out);
	Variable i;
	//Report in.Dimension, out.Dimension;
	If (in.Dimension == out.Dimension) then;
		For i=0 to in.Dimension-1;
			out[i] = out[i].And(in[i]);
		End;
	End;
EndProcedure;

//Returns percentage of array with value one
Define Procedure get_coverage_percentage(Array CoverageArray, Variable coverage_percentage);
	coverage_percentage = CoverageArray.Sum()/CoverageArray.Dimension;
EndProcedure;

Define Procedure get_instantaneous_coverage(Spacecraft sp, PointGroup Norsjoen_pointgroup, Array inst_coverage);
	inst_coverage.Fill(0,Norsjoen_pointgroup.Count);
	Norsjoen_pointgroup.Coverage(sp,inst_coverage);
EndProcedure;

Define Procedure Nadir_coverage(Spacecraft sp, PointGroup Norsjoen_pointgroup, Array coverage_array);
	//attitude control independant
	Array inst_coverage;
	inst_coverage.Fill(0,Norsjoen_pointgroup.Count);
	
	Call get_instantaneous_coverage(sp,Norsjoen_pointgroup,inst_coverage);
	Call array_bitwise_or(inst_coverage,coverage_array);
EndProcedure;

Define Procedure ROI_pointing_coverage(Spacecraft sp, PointGroup Norsjoen_pointgroup, Array target_position, Array coverage_array);
	Array inst_coverage;
	inst_coverage.Fill(0,Norsjoen_pointgroup.Count);
	
	Array target_vector;
	Matrix new_rot;
	
	//Array sensor_v = sp.Sensors[0].BoresightUnitVector;
	//Call get_vector_to_position(sp,target_position, target_vector);
	//Matrix target_v = target_vector.ToColumnMatrix();
	
	//Call get_rotation_between_vectors(target_v,sensor_v,new_rot);
	//sp.AttitudeMatrix = sp.AttitudeMatrix*new_rot;
	Call set_spacecraft_attitude_Rot(sp,target_position,{0,0,1});
	
	Call get_instantaneous_coverage(sp,Norsjoen_pointgroup,inst_coverage);
	Call array_bitwise_or(inst_coverage,coverage_array);
EndProcedure;

Define Procedure Reflection_maximum_pointing_coverage(Spacecraft sp, PointGroup Norsjoen_pointgroup, Array reflection_exists, List<Array> reflection_points_eci, Array coverage_array);
	Variable i;
	Variable j;
	Variable n;
	
	List<Array> reflection_array[reflection_points_eci.Count];
	For i=0 to reflection_array.Count-1 step 1;
		reflection_array[i].Fill(0,coverage_array.Dimension);
	End;
	Array reflection_percentages[reflection_points_eci.Count];
	reflection_percentages.Fill(0);
	
	Array inst_coverage;
	Variable inst_coverage_percentage=0;
	
	inst_coverage.Fill(0,coverage_array.Dimension);
	
	
	For i = 0 to reflection_points_eci.Count-1 step 1;
		//Report i;
		inst_coverage.Clear();
		inst_coverage.Fill(0,coverage_array.Dimension);
		inst_coverage_percentage = 0;
		If(reflection_exists[i] == 1);
			//Report i,reflection_exists.Sum();
			Call set_spacecraft_attitude_Rot(sp,reflection_points_eci[i],{0,0,1});
			Call get_instantaneous_coverage(sp,Norsjoen_pointgroup,inst_coverage);
			Call get_coverage_percentage(inst_coverage,inst_coverage_percentage);
		End;
		reflection_array[i] = inst_coverage;
		reflection_percentages[i] = inst_coverage_percentage;	
	End;
	Report reflection_percentages.Max();
	If(reflection_percentages.Max() == 0);
		sp.Quaternion = {0,0,0,1};
	Else;
		j = reflection_percentages.FindFirst(reflection_percentages.Max());
		Call set_spacecraft_attitude_Rot(sp,reflection_points_eci[j],{0,0,1});
		Call array_bitwise_or(reflection_array[j], coverage_array);
	End;
EndProcedure;



Define Procedure CoverageAnalysis(Spacecraft sp, Formation GNSS, PointGroup Norsjoen_pointgroup, Region Norsjoen, PointGroup reflection_current);
	Array instant_coverage[Norsjoen_pointgroup.Count];
	Norsjoen_pointgroup.Coverage(sp, instant_coverage);
EndProcedure;
