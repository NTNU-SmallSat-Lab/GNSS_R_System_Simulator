//Define Procedure find_max_coverage(Spacecraft sp, Formation GNSS, 

Define Procedure generateGNSSPlotObjects(PlotWindow p, Formation GPS, String PlotType);
	Variable i;
	For i=0 to GPS.Count-1 step 1;
		p.AddSeries(PlotType+"_"+GPS[i].SatelliteId,"PlotScatterSeries");
		p.Series[i].LineVisible=1;
	End;
EndProcedure;

Define Procedure updateGNSSPlotObjects(PlotWindow p, Formation GPS, Array values);
	Variable i;
	For i=0 to GPS.Count-1 step 1;
		(p.Series[i] AsType PlotScatterSeries).AddPoints(GPS[i].ElapsedTime.ToHours(),values[i]);
		p.Series[i].LineVisible=1;
	End;
	p.Update();
EndProcedure;



]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Check Mission Plan Run Mode</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// ---------------------------------------------------------------- //
// -- Determination whether the script is run nativally or called   //
//    as a client.                                                  //
//                                                                  //
// -- If the script is run natively:                                //
//    => Set up mission parameters here.                            //
// ---------------------------------------------------------------- //

Variable runNative;                                        // FF = 1 | ML = 0
Variable delta_T;                                          // seconds [s]
Variable no_GNSSR_sat;                                     // no. of GNSS-R satellites used
Variable sim_duration;                                     // Simulation duration [h]
String   GNSS_constelation;	                               // GNSS constelation [GPS | GALILEO | GLONASS | BEIDOU]
String   GNSS_R_TLE_path;                                  // Relative path to *.tle file for the GNSS-R satelitte(s)
String   satelliteID;
String   EPH_file_path;
String   EPH_folder_path;
String   EPH_file_name;
String   EPH_file_type;
String   file_path_GNSS_TLE = "../TLE_EPHEMIRIS_files";    // File path to the GNSS constellation TLE files
String   file_extention;                                   // File extention for the Ephemeris file
TimeSpan dt_timespan;			                           // Timespan as "TimeSpan" object

// --------------------------------------------- //
// -- Variables relevant for socket interface -- //
// --------------------------------------------- //
Variable i;                                            	   // Counter variable
Variable showGUI;
String terminationCode;
Array portNum[2];

// Checking if FreeFlyer is run from an other enviroment (e.g. MATLAB / C++)
If (FF_Preferences.UserInfo.Count == 0);
    runNative = 1;

    // Entering here if this MissionPlan is run from FreeFlyer
    Report "- Running FreeFlyer -" to Console;
    Console.CurrentTextColor = ColorTools.Orange;
    Console.CurrentFontType = 1;
    Report "-- Run FF natively --" to Console;
    Console.CurrentFontType = 0;
    Console.CurrentTextColor = ColorTools.Lime;

    // ----------------------------- //
    // -- User defined parameters -- //
    // ----------------------------- //
    EPH_folder_path     = 'C:\DocumentsLocal\07_Code\2_SMALLSAT\GNSS_R\GNSS_R_System_Sim\TLE_EPHEMIRIS_files\Autogenerated'; // This should never change!

    delta_T             = 20;
    GNSS_constelation   = 'GPS';
    GNSS_R_TLE_path     = 'C:\DocumentsLocal\07_Code\2_SMALLSAT\GNSS_R\GNSS_R_System_Sim\TLE_EPHEMIRIS_files\Autogenerated\gnssr_satID_4.tle';

    EPH_file_name       = 'GNSS_R_1';  // File name without extention
    EPH_file_type       = 'SPKephem';   // Can be [ FreeFlyer | CCSDS | STKephem | SPKephem ]
    no_GNSSR_sat        = 1;
    sim_duration        = 1;
    satelliteID         = '4';
    // ----------------------------- //
	
	// Determine Ephemeris file extention

    If (EPH_file_type=='FreeFlyer');
        file_extention= '.FFephem';
    ElseIf (EPH_file_type=='CCSDS');
        file_extention = '.e';
    ElseIf (EPH_file_type=='STKephem');
        file_extention = '.txt';
    ElseIf (EPH_file_type=='SPKephem');
        file_extention = '.bsp';
    Else;
        Report "Wrong Ephemeris file type specified" to Console;
    End;

    dt_timespan         = TimeSpan.FromSeconds(delta_T);
    showGUI             = 1;                                 // Always show the GUI when run natively
	EPH_file_path       = StringConcat(EPH_folder_path, '\', EPH_file_name, file_extention);
Else;
    runNative = 0;
    // Entering here if this MissionPlan is run as a client (e.g. called from MATLAB)
    Report "-- Run FF through external interface --" to Console;

    terminationCode = FF_Preferences.UserInfo[2];

    // Port number used by external interface (e.g. Matlab), 
    //   passed in through command-line call "-ui" (user info)
    portNum[0] = StringToFloat(FF_Preferences.UserInfo[0]);
    portNum[1] = StringToFloat(FF_Preferences.UserInfo[1]);
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Creat and Open Sockets</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// -------------------------------- //
// -- Create and Open Sockets    -- //
//                                  //
//    This script is only relevant  //
//    if run through an external    //
//    enviroment.                   //
// -------------------------------- //

// Create client input and output socket objects
Socket inSocket;
Socket outSocket;

If (runNative == 0);
    // IP address left blank if running on local machine 
    inSocket.IPAddress       = "";                   // Requires specification if executed through a server
    inSocket.PortNumber      = portNum[0];
    inSocket.SocketIsAscii   = 0;                    // Data input will be binary
    inSocket.SocketTimeout   = 60;
    inSocket.SocketType      = "client";
    inSocket.RecvTranslation = "swap";               // Needed for binary communication
    inSocket.SendTranslation = "swap";               // Needed for binary communication

    // IPaddress left blank if running on local machine  
    outSocket.IPAddress       = "";                  // Requires specification if executed through a server.
    outSocket.PortNumber      = portNum[1]; 
    outSocket.SocketIsAscii   = 1;                   // Data output will be ASCII
    outSocket.SocketTimeout   = -1;                  // Infinite
    outSocket.SocketType      = "client";

    // Open the input socket
    Open inSocket;

    // Open the output socket
    Open outSocket;

    If (inSocket.IsOpen and outSocket.IsOpen);
        Report @"\n-- FreeFlyer Socket connections are open! --\n" to Console;
    End;
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Recive data from server</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// ------------------------------ //
// -- Read in data from Socket -- //
//                                //
//    Populate (if run external): //
//    - GNSS-R TLE path           //
//    - GNSS constelation         //
//    - delta_T                   //
//    - sim_duration              //
//    - no_GNSSR_sat              //
// ------------------------------ //

String Server_string;
StringArray Server_string_array;
Variable inMatrixSize;
Array inMatrixDim[2];

// ------------------------------- //
// -- Read in String (TLE path) -- //
// ------------------------------- //
If (runNative == 0);
    Report @"- Data retrieval from Server -\n" to Console;

    // Recive String from MATLAB
    Receive Server_string from inSocket;

    // Devide matlab string into TLE file path for GNSS_R satellite and GNSS_constellations
    Server_string_array = Server_string.Split(" ");
    // Check to see what was sent from server
	satelliteID       = Server_string_array[0];
    GNSS_R_TLE_path   = Server_string_array[1];
	EPH_file_type     = Server_string_array[2];
	EPH_file_path     = Server_string_array[3];
    GNSS_constelation = Server_string_array[4];
    Report @"\n- TLE path and GNSS constelation(s) recived. -" to Console;
    Report "TLE path: " to Console;
    Report "     ", GNSS_R_TLE_path, @"\n" to Console;
    Report "Ephemiris path: " to Console;
    Report "     ", EPH_file_path, @"\n" to Console;
	Report "GNSS constelation: " to Console;
    Report "     ", GNSS_constelation, @"\n" to Console;

    // --------------------------------- //
    // -- Read in Array               -- //
    // --   > delta_T (step size Sim) -- //
    // --   > n_GNSS_satellits        -- //
    // --------------------------------- //
    Receive inMatrixDim from inSocket;
    //Report " Array size: " to Console;              //DEBUG
    //Report inMatrixDim.Format("%5.2f") to Console;  //DEBUG

    inMatrixSize = inMatrixDim[0]*inMatrixDim[1];
    //Report "inMatrixSize0: ", inMatrixDim[0], @"\n" to Console;  //DEBUG
    //Report "inMatrixSize1: ", inMatrixDim[1], @"\n" to Console;  //DEBUG
End;

Array inArray[inMatrixSize];
If (runNative == 0);
	If (inMatrixSize == 0);
		Report "inMatrixSize zero!";
	Else;
        Receive inArray from inSocket;
	End;

    // Check to see what was sent from server [DEBUG]
    //Report " Array value: " to Console;
    //For i = 0 to inArray.Dimension-1;
    //    Report inArray[i].Format("%5.2f") to Console;
    //End;

    // First entry is the delta_T
    showGUI            = inArray[0];     // boolean                                   [true / false]
    delta_T            = inArray[1];     // timestep                                  [seconds]
    sim_duration       = inArray[2];     // Simulation durartion                      [days]
    no_GNSSR_sat       = inArray[3];     // No. of GNSS-R satellites in the fomration [-]

    dt_timespan         = TimeSpan.FromSeconds(delta_T);
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="false">
        <Label>Set up mission parameters</Label>
        <Bookmarks />
        <Breakpoints>
          <Breakpoint line="15" enabled="true" />
        </Breakpoints>
        <FreeFormScript><![CDATA[// ---------------------------------------------- //
// -- Set up Spacecraft and mission parameters -- //
//      This scrip initializes the GNSS-R         //
//      spacecraft(s), and the GNSS Formation     //
// ---------------------------------------------- //

// TODO Add the posibility to have multiple GNSS_R spacecrafts
// ---------------------------------- //
// -- Initialize GNSS-R spacecraft -- //
// ---------------------------------- //


Array      Satellite_coverage_model;
Array      GNSSR_state;
Array      use_ADCS;
 

/*
Models:
  NADIR_pointing:                          0
  Fixed_Point_pointing:                    1	
  Maximum_coverage_Reflection_pointing:    2
*/
Satellite_coverage_model.Fill(0, no_GNSSR_sat);
//add commands to customize values manually here


/*
Operational modes:
IDLE:	  0
GNSS_R:   1
COMMS:    2
Charging: 3
...
*/
GNSSR_state.Fill(1,no_GNSSR_sat);

//list of GS used in operational modes procedures. Must be defined manually.
List<GroundStation> list_GS[3];
list_GS[0] = GS_KSAT_SVALBARD;
list_GS[1] = GS_Florida;
list_GS[2] = GS_South_Africa;

//Array 
use_ADCS.Fill(0, no_GNSSR_sat);
/*
List<Variable> use_ADCS_list[no_GNSSR_sat];
For i=0 to use_ADCS_list.Count-1 step 1;
	use_ADCS_list[i] = 0;
End;
*/]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>setup GNSS constelation</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// ---------------------------------------------- //
// --                setup GNSS                -- //
//   This script sets up the GNSS-constelation    //
//   used, [GPS | GALILEO | GLONASS | BEIDOU]     //
// ---------------------------------------------- //
Formation GNSS;
String full_path_gnss_tle;
Array GNSS_ColorsArray;
Variable sat_i;
GraphicsOverlay GraphicsReflection;

// ----------------------------------- //
// -- Read in GNSS-constelation TLE -- //
// ----------------------------------- //
//define GNSS formation using fixed file
If (GNSS_constelation == "GPS");
	full_path_gnss_tle = StringConcat(file_path_GNSS_TLE, "/GPS_operational.tle");
ElseIf (GNSS_constelation == "GALILEO");
	full_path_gnss_tle = StringConcat(file_path_GNSS_TLE, "/GALILEO.tle");
ElseIf (GNSS_constelation == "GLONASS");
	full_path_gnss_tle = StringConcat(file_path_GNSS_TLE, "/GLONASS_operational.tle");
ElseIf (GNSS_constelation == "BEIDOU");
	full_path_gnss_tle = StringConcat(file_path_GNSS_TLE, "/BEIDOU.tle");
Else;
	// Wrong GNSS-constalation chosen
End;
GNSS.LoadTLE(full_path_gnss_tle);

Report "No. GNSS satellites: ", GNSS.Count, @"\n" to Console;
If (showGUI == 1);
    //define array of colors used for GNSS formation visualization
    GNSS_ColorsArray = ColorTools.GetPaletteColors("Bright", GNSS.Count);
End;
	
For i=0 to GNSS.Count-1 step 1;
    //Add Coverage sensor for GNSS satellites
    GNSS[i].AddSensor("g"+i.ToString());
    GNSS[i].Sensors[0].ConeHalfAngle    = 10;
    GNSS[i].Sensors[0].Active           = 1;
    GNSS[i].Sensors[0].ProjectionHeight = 25000;
    GNSS[i].Sensors[0].Color            = ColorTools.Yellow;
    GNSS[i].Sensors[0].Opacity          = 0.2;

    //add "Line-of-sight-sensor" for GNSS satellites
    GNSS[i].AddSensor("LOS_"+i.ToString());
    GNSS[i].Sensors[1].Active           = 1;
    GNSS[i].Sensors[1].ConeHalfAngle    = 180;
    GNSS[i].Sensors[1].ProjectionHeight = 25000;
    GNSS[i].Sensors[1].Color            = ColorTools.White;
    GNSS[i].Sensors[1].Opacity          = 0;

    GNSS[i].AddSensor("p"+i.ToString());
    GNSS[i].Sensors[1].Active           = 0;
    GNSS[i].Sensors[1].ConeHalfAngle    = 5;
    GNSS[i].Sensors[1].ProjectionHeight = 25000;
    GNSS[i].Sensors[1].Color            = ColorTools.Blue;
    GNSS[i].Sensors[1].Opacity          = 0.2;

    //other properties
    GNSS[i].SetPropagatorType("SGP4");
	If (showGUI == 1);
        GNSS[i].Color                       = GNSS_ColorsArray[i];
	End;
End;

// define graphics objects for visualization of reflections
For sat_i=0 to no_GNSSR_sat-1 step 1;
    For i=0 to GNSS.Count-1 step 1;
        GraphicsReflection.AddShape();
 	    GraphicsReflection.Shapes[sat_i*GNSS.Count + i].SetLineWidth(0,1);
    End;
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Setup GNSS-R satellite</Label>
        <Bookmarks />
        <Breakpoints>
          <Breakpoint line="72" enabled="true" />
        </Breakpoints>
        <FreeFormScript><![CDATA[/*
Form used for defining the GNSS-R satellite/formation used in the simulation, and properties related to the spacecraft.
Also defines "GNSS-R coverage" and COMMS sensors for the satellite
*/

//Set the size of the formation equal to value defined in form one
// ------------------------------------ //
// --- Initialize GNSS-R spacecraft --- //
// ------------------------------------ //
Formation  GNSS_R;
String     tle_title_gnssrSat;

// Verify data was loaded
Report "GNSS-R satellite initialized from TLE data:" to Console;

GNSS_R.Count                      = no_GNSSR_sat;
//Variable use_walker_constellation = 0;
/* Variable n_Walker_orbits          = 1;

Array satellite_A[no_GNSSR_sat];
Array satellite_e[no_GNSSR_sat];
Array satellite_I[no_GNSSR_sat];
Array satellite_RAAN[no_GNSSR_sat];
Array satellite_W[no_GNSSR_sat];
Array satellite_TA[no_GNSSR_sat];
*/

// Set the spacecraft time equal to GNSS time/epoch to ensure simulation synchronization
For i=0 to GNSS_R.Count-1 step 1;
	GNSS_R[i].Epoch = GNSS[0].Epoch;
End;

//define half
Variable COMMS_half_cone_angle          = 35; // [deg]. 35 deg corresponds to approximately an S-band antenna. 
Variable GNSS_R_half_cone_angle         = 15; // [deg]. Used for coverage analysis of GNSS-R baseline sensor
Variable sun_sensor_LOS_half_cone_angle = 3; //[deg]. Used for angle between sun and "plates" of cubesat

//define walker constellation 
/*If(use_walker_constellation);
	For sat_i=0 to GNSS_R.Count-1 step 1;
		For i=0 to n_Walker_orbits-1 step 1;
			satellite_A[sat_i] = 1;
			satellite_e[sat_i] = 1;
			satellite_I[sat_i] = 1;
			satellite_RAAN[sat_i] = 1;
			satellite_W[sat_i] = 1;
			satellite_TA[sat_i] = 1;
		End;
	End;
Else;
	For sat_i=0 to GNSS_R.Count-1 step 1;
		satellite_TA[sat_i] = sat_i*360/no_GNSSR_sat ;
	End;
End;*/

// ------------------------------------- //
// --- READ TLE for GNSS-R satellite --- //
// ------------------------------------- //
For i=0 to GNSS_R.Count-1 step 1;
	tle_title_gnssrSat = StringConcat("GNSS-R " , satelliteID);
    GNSS_R[i].LoadTLE(GNSS_R_TLE_path, tle_title_gnssrSat);
End;

For i=0 to GNSS_R.Count-1 step 1;
//	GNSS_R[i]                     = GNSS_R_spacecraft;               //Set the formation to inherit values defined in spacecraft 1. Note: Not all values/objects will be inherited from this
    Call define_gnss_r_sp(GNSS_R[i], 1);                             // TODO: Define GNSS_R spacecraft in "define_gnss_r_spacecraft"
    GNSS_R[i].Propagator.StepSize = dt_timespan;                     // set the propagator step-size equal to pre-determined values.

    //Define how the different spacecraft objects' orbits will deviate from eachother in the formation.
    GNSS_R[i].TA = i*360/no_GNSSR_sat; 

    //Add sensors to Spacecraft objects according to options defined in the initial form.
    //Call set_Satellite_coverage_sensor(GNSS_R[i],Satellite_coverage_model[i],GNSS_R_half_cone_angle,{0,0,1},i);
    //Call define_Comms_sensor(GNSS_R[i],GNSS_R_half_cone_angle,{0,1,0},i);
    //Call define_solar_sensors(GNSS_R[i],sun_sensor_LOS_half_cone_angle,i);

    //Report GNSS_R[i].Sensors.Count;
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Prepaire Ephemeris</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Related to Ephemeris file
Ephemeris Ephemeris_GNSS_R;
//SpiceEphemeris SPICE_Ephemeris_GNSS_R; // This is only used for the case: "SPKephem"

// Create Ephemiris
Ephemeris_GNSS_R.CentralBody    = "Earth";
Ephemeris_GNSS_R.WritePosVel    = 1;
If (EPH_file_type != 'CCSDS');
    Ephemeris_GNSS_R.WriteAttitude  = 1;
End;

If (EPH_file_type=='SPKephem');
	//SPICE_Ephemeris_GNSS_R.ObjectId = 'GNSS_R_1';
	
End;

//Ephemeris_GNSS_R.WritePositionVelocityCovariance = 1;
//Ephemeris_GNSS_R.WriteClockBiasAndDrift = 1;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>While-Loop | Step Formations</Label>
        <Bookmarks />
        <Breakpoints>
          <Breakpoint line="94" enabled="true" />
        </Breakpoints>
        <FreeFormScript><![CDATA[// Related to Area displayed
Region NorthSea;
NorthSea.NumberOfVertices = 4;
NorthSea.Latitude         = {60.2, 77, 61.9, 44.3};
NorthSea.Longitude        = {-44.2, 16.37, 4, -9};
PointGroup NorthSea_pointgroup;

// Related to execution
Variable error_var;
Variable success = 1;

// ----------------------------------------- //
// Add the first state to the Ephemeris file
// ----------------------------------------- //
For i=0 to GNSS_R.Count-1 step 1;
    Put GNSS_R[i] to Ephemeris_GNSS_R;
//    Put GNSS_R[i].Velocity to Ephemeris_GNSS_R;
End;
//For i=0 to GNSS.Count-1 step 1;
//    Put GNSS[i] to Ephemeris_GNSS_R;
//End;

TimeSpan simDurationTimeSpan;
simDurationTimeSpan = TimeSpan.FromSeconds(sim_duration * 86400.123);

While(GNSS_R[0].ElapsedTime < simDurationTimeSpan);
//While (GNSS_R[0].ElapsedTime < TIMESPAN(sim_duration days));
    // ----------------------------------------- //
    // --            Visualization            -- //
    // ----------------------------------------- //
	If (showGUI == 1);
        Plot GNSS_R[0].ElapsedTime, GNSS_R[0].Height;
        View GNSS_R[0];
	End;
	// ----------------------------------------- //
    // --     Propagate GNSS-R formation      -- //
	//          - This is only relevant if       //
	//            there are more than 1 GNSS-R   //
	//            satellite                      //
    // ----------------------------------------- //
    For i=1 to GNSS_R.Count-1 step 1;
        Step GNSS_R[i] to (GNSS_R[i].Epoch == GNSS_R[0].Epoch);
    End;

	// ----------------------------------------- //
    // --       Propagate GNSS formation      -- //
    // ----------------------------------------- //
    For i=1 to GNSS.Count-1 step 1;
        Step GNSS[i] to (GNSS[i].Epoch == GNSS_R[0].Epoch);
    End;

    // ----------------------------------------- //
    // --            Visualization            -- //
    // ----------------------------------------- //
    If (showGUI == 1);
        View NorthSea<800>, NorthSea_pointgroup, GNSS, GNSS_R;
    	Map GNSS, GNSS_R;
    End;
//   	Plot GNSS_R[0].ElapsedTime, GNSS_R[0].Velocity;     

    // ----------------------------------------- //
    // --    Propagate Spacecraft in time     -- //
    // ----------------------------------------- //
    Try sending ErrorCount to error_var;
        Step GNSS_R[0];
    End;
	If (error_var > 0);
		Report "Spacecraft could not be propagated   \n   Error:", error_var, @"\n" to Console;
		success = 0;
		Break;
	End;

	// ----------------------------------------- //
    // -- Add Spacecraft States to Ephemiris  -- //
    // ----------------------------------------- //
    For i=0 to GNSS_R.Count-1 step 1;
        Put GNSS_R[i] to Ephemeris_GNSS_R;
    End;
	//For i=0 to GNSS.Count-1 step 1;
	//	Put GNSS[i] to Ephemeris_GNSS_R;
	//End;
End;

// ----------------------------------------- //
// --        Write Ephemiris File         -- //
// ----------------------------------------- //
// Check if there is a file at the designated path
Variable ephExists = FileSystem.Exists(EPH_file_path);
If (ephExists == 1);
    Report "Ephemiris file overwrites previous version" to Console;
    // Remove previous file
    FileSystem.Delete(EPH_file_path);
End;

If (EPH_file_type=='FreeFlyer');
	Put Ephemeris_GNSS_R to FFephem EPH_file_path;
    //Ephemeris_GNSS_R.GenerateEphemeris(0, EPH_file_path);
ElseIf (EPH_file_type=='CCSDS');
    Put Ephemeris_GNSS_R to CCSDSOEM EPH_file_path;
	//Ephemeris_GNSS_R.GenerateEphemeris(0, EPH_file_path);
ElseIf (EPH_file_type=='STKephem');
	Put Ephemeris_GNSS_R to STKephem EPH_file_path;
	//Ephemeris_GNSS_R.GenerateEphemeris(2, EPH_file_path);
ElseIf (EPH_file_type=='SPKephem');
	Report "SPK Ephemeris file not yet implemented TBD!!" to Console;
//    Put Ephemeris_GNSS_R to SPKephem EPH_file_path;
	//Ephemeris_GNSS_R.GenerateEphemeris(3, EPH_file_path);
Else;
    Report "Ephemeris file could not be generated!" to Console;
End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Output Data</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[// Creating first output array
Array outArray[1];
StringArray stringResponse[1];


If (runNative == 0);
    // Create Output Data

    stringResponse[0] = EPH_file_path;

    For i = 0 to outArray.Dimension-1;
        outArray[i] = success;
    End;

//    //Creating double output
//    arrRSS = sqrt(outArray_test[0]^2 + outArray_test[1]^2 + outArray_test[2]^2 + 
//    				 outArray_test[3]^2 + outArray_test[4]^2 + outArray_test[5]^2);

//    // Creating fifth output array
//    bigArray.Clear();

//    For i = 0 to 45;
//    	bigArray.PushBack(GaussianNoise(0,10));
//    End;
End;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Send responses back to MATLAB</Label>
        <Bookmarks />
        <Breakpoints>
          <Breakpoint line="18" enabled="true" />
        </Breakpoints>
        <FreeFormScript><![CDATA[
// Send responses back to Server

// Create a data-passage protocol, seen below.  

// For a data-type of STRING, you must first send "STR" preceeding the data.  To pass a data-type of DOUBLE, you must first send "DBL" 
// preceeding the data.  To pass a 1x6 element ARRAY, you must preceed it with "ARR". Finally, to pass a large array, you must preceed it with 
// "bigARR".

// NOTE: This Mission Plan and supporting MATLAB script can support arrays of various sizes. However, MATLAB requires various sized arrays to be lumped together into 
// same-sized groups.  Therefore, if you want to send multiple arrays all of differing sizes, you must create a new protocol for each diffent size. 

Constant String STR         = "STR";
Constant String STR_ARRAY   = "strARR";
Constant String ARR         = "ARR";
Constant String BIG_ARR     = "bigARR";
Constant String DBL         = "DBL";

Define Macro SendData(dataType, rawData, socket);
    
    Send dataType to socket;
    Send rawData to socket;
    
EndMacro;

If (runNative == 0);

    
    Call SendData(STR_ARRAY,   stringResponse, outSocket);
    
    Call SendData(ARR,       outArray, outSocket);
    
//    Call SendData(DBL,       42,        outSocket);
//    Call SendData(DBL,       arrRSS,    outSocket);
    
//    Call SendData(BIG_ARR,   bigArray,  outSocket);
//    Call SendData(ARR,       outArray6, outSocket);
    
    Send terminationCode to outSocket; // Unique and arbitrary number sequence signifying the final transmission
    
    Close inSocket;
    Close outSocket;
    
    Stop;
End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[// -------------------------------- //
// -- Mission plan description   -- //
//     This mission plan reads in:  //
//      - TLE (file path)           //
//      - no GNSS-R satellites TODO: automize this in the future     //
//      - GNSS Sat config           //
//      - simulation duration       //
//      - simulation step size      //
//     And it returns:              //
//      - Ephemiris file of the     //
//        GNSS-R satellite(s)       //
//                                  //
// -- This Mission plan can be   -- //
//    run natively (from FreeFlyer) //
//    or be called through a socket //
//    (client)                      //
// -------------------------------- //

Console.Dimension        = 50;
Console.WordWrap         = 1;
Console.DockMode         = 3;
Console.BackColor        = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.WindowTitle      = "Mission Plan: TLE to EPHEMIRIS";
Console.UseStdOut        = 1;
Console.Show();
// =============================================================================================== //
// ==                                     GENERATE OUTPUT                                       == //
// =============================================================================================== //
// ------------------------------------------------------------------------------------- //
// --                             WRITE EPHEMIRIS FILE                                -- //
// ------------------------------------------------------------------------------------- //
Define Procedure write_ephemiris_to_file(Ephemeris eph_file, String file_path);
	// Check if there is a file at the designated path
	Variable ephExists;

	ephExists = FileSystem.Exists(file_path);
	If (ephExists == 1);
		Report "Ephemiris file overwrites previous version" to Console;

		// Remove previous file
		FileSystem.Delete(file_path);
		
		//// Create new empty file
		//FileSystem.CreateDirectory(file_path);
	End;
	
	// Write EPHEMIRIS to file:
	// TODO
EndProcedure;

// =============================================================================================== //
// ==                            DEFINE SPACECRAFT AND SENSORS                                  == //
// =============================================================================================== //
// ------------------------------------------------------------------------------------- //
// --                      Define GNSS_R spacecraft (setup)                           -- //
// ------------------------------------------------------------------------------------- //
Define Procedure define_gnss_r_sp(Spacecraft sp, Variable tbd);
    // TODO
//	String gnss_sensor = "gnss_sensor";
//    sp.AddGNSSReceiver(gnss_sensor);
//	sp.GNSSReceivers[0].OD.GNSSObservation.ClockBias.Value = 0.1;
EndProcedure;

Define Procedure define_Single_Sensor(Spacecraft sp, Variable half_cone_angle, Array boresight_vector, Variable sat_i);
	Variable n = sp.Sensors.Count;
	sp.AddSensor(StringConcat("coverage_sat",sat_i.ToString(),"_",n.ToString()));
	sp.Sensors[sp.Sensors.Count-1].Active = 1;
	sp.Sensors[sp.Sensors.Count-1].BoresightUnitVector = boresight_vector;
	sp.Sensors[sp.Sensors.Count-1].Color = ColorTools.Yellow;
	sp.Sensors[sp.Sensors.Count-1].ConeHalfAngle = half_cone_angle;
EndProcedure;

Define Procedure define_Comms_sensor(Spacecraft sp, Variable half_cone_angle, Array boresight_vector, Variable sat_i);
	sp.AddSensor(StringConcat("Comms_sat",sat_i.ToString()));
	sp.Sensors[sp.Sensors.Count-1].Active = 0;
	sp.Sensors[sp.Sensors.Count-1].BoresightUnitVector = boresight_vector;
	sp.Sensors[sp.Sensors.Count-1].Color = ColorTools.Green;
	sp.Sensors[sp.Sensors.Count-1].ConeHalfAngle = half_cone_angle;
EndProcedure;

Define Procedure define_solar_sensors(Spacecraft sp, Variable half_cone_angle, Variable sat_i);
	List<Array> boresight_vector_list[6];
	boresight_vector_list[0] = {1,0,0};
	boresight_vector_list[1] = {-1,0,0};
	boresight_vector_list[2] = {0,1,0};
	boresight_vector_list[3] = {0,-1,0};
	boresight_vector_list[4] = {0,0,1};
	boresight_vector_list[5] = {0,0,-1};
	
	Variable i;
	Variable n;
	
	For i=0 to  boresight_vector_list.Count-1 step 1;
		n = sp.Sensors.Count;
		sp.AddSensor(StringConcat("sunLOS_sat",sat_i.ToString(),"_",n.ToString()));
		sp.Sensors[sp.Sensors.Count-1].Active = 0;
		sp.Sensors[sp.Sensors.Count-1].BoresightUnitVector = boresight_vector_list[i];
		sp.Sensors[sp.Sensors.Count-1].ConeHalfAngle = half_cone_angle;
	End;
EndProcedure;

Define Procedure set_Satellite_coverage_sensor(Spacecraft sp, Variable Satellite_coverage_model, Variable half_cone_angle, Array boresight_vector, Variable sat_i);
	Call define_Single_Sensor(sp,half_cone_angle,boresight_vector,sat_i);
EndProcedure;

Define Procedure set_coverage_sensor_status(Spacecraft sp, Variable sensor_state);
	Variable i;
	For i=0 to sp.Sensors.Count-1 step 1;
		If(sp.Sensors[i].DeclaredName.Find("coverage") > -1);
			sp.Sensors[i].Active = sensor_state;
		End;
	End;
EndProcedure;

Define Procedure set_comms_sensor_status(Spacecraft sp, Variable sensor_state);
	Variable i;
	For i=0 to sp.Sensors.Count-1 step 1;
		If(sp.Sensors[i].DeclaredName.Find("Comms") > -1);
			sp.Sensors[i].Active = sensor_state;
		End;
	End;
EndProcedure;

Define Procedure set_sun_sensor_status(Spacecraft sp, Variable sensor_state);
	Variable i;
	For i=0 to sp.Sensors.Count-1 step 1;
		//Report i, sp.Sensors[i].Active, sp.Sensors[i].DeclaredName;
		If(sp.Sensors[i].DeclaredName.Find("sun") > -1);
			sp.Sensors[i].Active = sensor_state;
		End;
	End;
EndProcedure;

// =============================================================================================== //
// ==                               CALCULATE REFLECTION POINT                                  == //
// =============================================================================================== //

// Returns the skew symmetric matrix of the Vector/1xn Matrix v as the Matrix Sv
Define Procedure skew_matrix(Matrix v, Matrix Sv);
	Sv = [0,-v[2,0],v[1,0];v[2,0],0,-v[0,0];-v[1,0],v[0,0],0];
EndProcedure;

// Used to find Rotation matrix needed to transform from ecef coordinates to coordinates with 
// z-axis vector orthogonal to the plane spanning the points: 
// {earth center}, {GNSS-R satellite center] and {Center of GNSS satellite in question}
Define Procedure getRotationEcefToPlaneCoords(Matrix satCoord, Matrix GPSCoord, Matrix Rot);
	Matrix plane = satCoord.CrossProduct(GPSCoord);
	plane = plane/plane.Norm(2);
	Matrix z = [0;0;1]; 
	
	Matrix vec = plane.CrossProduct(z);
	Variable s = vec.Norm(2);
	Variable c = plane.DotProduct(z);
	
	Matrix vec2 = vec/vec.Norm(2);
	Variable theta = acos(plane.DotProduct(z)/(plane.Norm(2)*1));
	Variable c2 = cos(theta);
	Variable s2 = sin(theta);
	Matrix Sv;
	Call skew_matrix(vec2,Sv);
	
	Rot = Matrix.Identity(3) + s2*Sv + Sv*Sv*(1-c2);
EndProcedure;

Define Procedure get_reflection_point2D(Matrix satCoord1, Matrix GPSCoord1, Matrix N, Matrix A, Matrix B);
	Variable Re = Earth.RadiusEquatorial;
	
	A = [satCoord1[0,0]; satCoord1[1,0]]/Earth.RadiusEquatorial; //only pick x- and y positions since z = 0;
    B = [GPSCoord1[0,0]; GPSCoord1[1,0]]/Earth.RadiusEquatorial;
    Variable u = A.DotProduct(A);
    Variable v = A.DotProduct(B);
    Variable w = B.DotProduct(B);
    Variable r0 = w - 1;
    Variable r1 = 2 * (w - v);
    Variable r2 = u + 2 * v + w - 4 * u *w;
    Variable r3 = 4 * (v * v - u * w);
    Variable r4 = 4 * u * (u * w - v * v);


    Variable numRoots = 0;
    Matrix coefvct = [r4, r3, r2, r1, r0];     // Coefficient Vector
    Matrix R = coefvct.PolynomialRoots();
    //R = real(R);
    numRoots = max(R.RowCount,R.ColumnCount);
	
	//	   test from Jules code
	//     Checking the accuracy of the roots computed
	//     for i = 1:numRoots
	//         verif = r4*R(i)^4 + r3*R(i)^3 + r2*R(i)^2 + r1*R(i) + r0;
	//         R(i)=norm(R(i));
	//     end

    Variable x = 0;
    Variable y = 0;
	Variable i = 0;
    For i = 0 to numRoots-1 step 1;
       	x = R[i,0];
        If(x > 0);
            y = (1 + x - 2 * u * x * x) / (1 + 2 * v * x);
            If(y > 0);
                Break;
            End;
        End;
    End;
   	//Matrix N;

    N = x * A + y * B;
    //Variable verif = r4*x^4 + r3*x^3 + r2*x^2 + r1*x + r0;

	//elevation angles etc currently not in use.

    //alpha = atan2(N(2), N(1));
    /*alpha = atan2(norm(cross([A;0],[N;0])), dot([A;0],[N;0]));
    //phi = acos(dot(A / norm(A), B / norm(B)));
    phi = atan2(norm(cross([A,0],[B,0])), dot([A,0],[B,0]));
    //beta = phi - alpha;
    beta = phi- alpha;
    
    //gamma0 = atan((cos(alpha) - 1 / norm(A)) / sin(alpha));
    //gamma1 = atan((cos(beta) - 1 / norm(B)) / sin(beta));
    gamma0 = atan((cos(alpha) - 1 / norm(A)) / sin(alpha));
    gamma1 = atan((cos(beta) - 1 / norm(B)) / sin(beta));
	
	*/
    N = Re * N; //scale positions to earth radius
EndProcedure;

//Probably contains an error. Is not in use
/*Define Procedure get_reflection_angles(Matrix N, Matrix A, Matrix B, Variable alpha, Variable beta, Variable phi, Variable gamma);
	//Variable alpha;
	alpha = atan2(N[1,0],N[0,0]);
	Matrix a = A/A.Norm();
	phi = acos(a.DotProduct(B/B.Norm()));
	beta = phi-alpha;
	gamma = atan((cos(alpha)-1/B.Norm())/A.Norm());
	//Report gamma, phi;
EndProcedure;*/
 
//Main function used in loop for calculating reflection points.  
//The functionn assumes that the satellites have "line-of-sight" contact. In other words, the direct line between them is not blocked by the earth.
//This guarantees that the reflection will always be on the "outside" of the earth sphere
Define Procedure get_reflection_point(Spacecraft sp, Spacecraft gps_sat, Array satPos, Array ReflectionPoint, Variable elevationAngle);
	Array gpsPos = PositionConvert(1,4,sp.Epoch,gps_sat.Position);
	
	
	Matrix satCoord = satPos.ToColumnMajorMatrix(3);
	Matrix GPSCoord = gpsPos.ToColumnMajorMatrix(3);
	Matrix Rot;
	
	Call getRotationEcefToPlaneCoords(satCoord,GPSCoord,Rot);
	
	Matrix satCoord1 = Rot*satCoord;
	Matrix GPSCoord1 = Rot*GPSCoord;
	Matrix N;
	Matrix A;
	Matrix B;
	Variable alpha;
	Variable beta;
	Variable phi;
	Variable gamma;
	
	Call get_reflection_point2D(satCoord1,GPSCoord1,N,A,B);
	
	//Call get_reflection_angles(N,A,B,alpha,beta,phi,gamma); //
	
	N = [N;0]; //transform coordinate to 3d. z-axis is 0 since reflection point is assumed to be on the calculated plane.
	elevationAngle = -1; //check currently not in use 
	Matrix reflectionPoint = Rot.Transpose()*N; //Transform coordinates back to ECEF-frame.
	ReflectionPoint = {reflectionPoint}; //return reflection point as an Array 
EndProcedure;

//Adds lines to represent the ideal reflection from "satPos" to "reflectionPoint" to "GNSSPos". index represents which satellite
//Note: input node/vertex positions must be in ECEF-Coordinate frame. 
Define Procedure updateReflectionGraphics(Array satPos, Array GNSSPos, Array reflectionPoint, Variable graphicsIndex, Variable GNSS_index, GraphicsOverlay g, Array GNSSColorsArray);
	g.Shapes[graphicsIndex].AddElement(satPos[0],satPos[1],satPos[2]); //add GNSS-R vertex
	g.Shapes[graphicsIndex].AddElement(reflectionPoint[0],reflectionPoint[1],reflectionPoint[2]); //add reflection vertex
	g.Shapes[graphicsIndex].AddElement(GNSSPos[0],GNSSPos[1],GNSSPos[2]); //add GNSS vertex
	g.Shapes[graphicsIndex].Colors = {GNSSColorsArray[GNSS_index],GNSSColorsArray[GNSS_index],GNSSColorsArray[GNSS_index]}; //set color
EndProcedure;

// =============================================================================================== //
// ==                                        MATHEMATICS                                        == //
// =============================================================================================== //
// ------------------------------------------------------------------------------------- //
// --                                                                                 -- //
// ------------------------------------------------------------------------------------- //
/*
Form contains procedures needed for an ADCS simulation, including attitude dynamics, disturbance torques, controllers, 
[unfinished] actuator models, some utility functions for these and simple numerical integrators.


*/

//Returns the skew symmetric matrix
/*Define Procedure skew_matrix(Matrix v, Matrix Sv);
	Sv = [0,-v[2,0],v[1,0];v[2,0],0,-v[0,0];-v[1,0],v[0,0],0];
EndProcedure;
*/
//transforms quaternion from scalar last to scalar first form.
//Returns the same quaternion parameter
Define Procedure quaternion_make_scalar_first(Matrix q);
	Variable k = q[3,0];
	q[3,0] = q[2,0];
	q[2,0] = q[1,0];
	q[1,0] = q[0,0];
	q[0,0] = k;
EndProcedure;

//transforms quaternion from scalar fisrt to scalar last form.
//Returns the same quaternion parameter
Define Procedure quaternion_make_scalar_last(Matrix q);
	Variable k = q[0,0];
	q[0,0] = q[1,0];
	q[1,0] = q[2,0];
	q[2,0] = q[3,0];
	q[3,0] = k;
EndProcedure;

//transforms quaternion from scalar last to scalar first form.
//Returns the new quaternion parameter in q_out
Define Procedure quaternion_copy_make_scalar_first(Matrix q, Matrix q_out);
	q_out = [1;0;0;0];
	q_out[3,0] = q[2,0];
	q_out[2,0] = q[1,0];
	q_out[1,0] = q[0,0];
	q_out[0,0] = q[3,0];
EndProcedure;

//transforms quaternion from scalar fist to scalar last form.
//Returns the new quaternion parameter in q_out
Define Procedure quaternion_copy_make_scalar_last(Matrix q, Matrix q_out);
	q_out = [0;0;0;1];
	q_out[0,0] = q[1,0];
	q_out[1,0] = q[2,0];
	q_out[2,0] = q[3,0];
	q_out[3,0] = q[0,0];
EndProcedure;

//Calculate the quaternion conjugate, and return it
Define Procedure quaternion_conjugate(Matrix q, Matrix q_conj);
	q_conj[0,0] = q[0,0];
	q_conj[1:3,0] = -q[1:3,0];
EndProcedure;

//Calculate the unit quaternion product of q1 and q2. Return it as q_out. All quaternions are assumed to be unit sized
Define Procedure quaternion_multiplication(Matrix q1, Matrix q2, Matrix q_out);
	q1=q1.Normalized();
	q2=q2.Normalized();
	Matrix eta1 = q1[1:3,0];
	Variable nu1 = q1[0,0];
	Matrix eta2 = q2[1:3,0];
	Variable nu2 = q2[0,0];
	
	q_out[0,0] = nu1*nu2 - eta1.DotProduct(eta2);
	q_out[1:3,0] = nu1*eta2 + nu2*eta1 + eta1.CrossProduct(eta2);
	Report q_out.Norm();
	q_out = q_out.Normalized();
EndProcedure;

Define Procedure get_vector_to_position(Spacecraft sp, Array Position, Array Array1);
	Array1 = AttitudeConvert(0,3,sp,Position - sp.Position);
	Array1.Normalized();
EndProcedure;

//Calculate and return
Define Procedure get_R_o_i(Spacecraft sp, Matrix R_o_i);
	Matrix r_i = sp.Position.ToColumnMatrix();
	Matrix v_i = sp.Velocity.ToColumnMatrix();
	Matrix z_o_hat = -r_i/r_i.Norm(2);
	Matrix y_o_hat = -r_i.CrossProduct(v_i)/r_i.CrossProduct(v_i).Norm(2);
	Matrix x_o_hat = y_o_hat.CrossProduct(z_o_hat);
	R_o_i = [x_o_hat,y_o_hat,z_o_hat];
	//Report R_o_i.Determinant();
EndProcedure;

Define Procedure get_R_b_o(Spacecraft sp, Matrix R_b_o);
	Array q_bo = sp.Quaternion;
	Variable nu = q_bo[3];
	Matrix eta = [q_bo[0];q_bo[1];q_bo[2]];
	Matrix S_eta;
	Call skew_matrix(eta,S_eta);
	Matrix R_o_b = Matrix.Identity(3) + 2*nu*S_eta + 2*S_eta*S_eta;
	R_b_o = R_o_b.Transpose();
	//Report R_b_o.Determinant();
EndProcedure;

Define Procedure get_omega_b_io(Spacecraft sp, Matrix w_b_io, Matrix R_o_i, Matrix R_b_o);
	Matrix S__r_i;
	Matrix r_i = sp.Position.ToColumnMatrix();
	Matrix v_i = sp.Velocity.ToColumnMatrix();
	Call get_R_o_i(sp, R_o_i);
	Call get_R_b_o(sp, R_b_o);
	Call skew_matrix(r_i,S__r_i);
	Matrix w_o_io = R_o_i*S__r_i*v_i/(r_i.Transpose()*r_i);
	w_b_io = R_b_o*w_o_io;
EndProcedure;

Define Procedure get_omega_b_ob(Matrix w_b_ib, Matrix w_b_io, Matrix w_b_ob);
	w_b_ob = w_b_ib - w_b_io;
EndProcedure;

Define Procedure Calculate_psuedo_inverse(Matrix A, Matrix A_psuedo_inverse);
	Matrix A_T = A.Transpose();
	Matrix A_times_At = A*A_T;
	Matrix A_times_At_inv = A_times_At.Inverse();
	A_psuedo_inverse = A_T*A_times_At_inv;
EndProcedure;

//Define Procedure draw_sun_vector(Spacecraft sp, GraphicsOverlay g);
//	Array sun_vector = AttitudeConvert(0,4,sp,sp.VectorToObject(Sun));
//	Array earth_vector = AttitudeConvert(0,4,sp,sp.VectorToObject(Earth));
//	Array a = earth_vector.CrossProduct(sun_vector);
//	
//EndProcedure;

// =============================================================================================== //
// ==                                      ORBIT MECHANICS                                      == //
// =============================================================================================== //

//simulation config params
Define Procedure calculate_gravity_gradient_torque(Spacecraft sp, Matrix R_b_o, Matrix tau_g);
	Matrix c3 = R_b_o[0:2,2];
	Matrix J = sp.MOI;
	Variable mu = Earth.Mu*1e3;
	Matrix r_i = sp.Position.ToColumnMatrix();
	Matrix S_c3;
	Call skew_matrix(c3, S_c3);
	
	tau_g = 3*mu/((r_i.Norm())^3)*S_c3*J*c3;
EndProcedure;

//placeholder
Define Procedure calculate_drag_torque(Spacecraft sp, Array drag_dist_params, Matrix x_CG, Matrix x_CP, Matrix tau_drag);
	Variable rho_drag = drag_dist_params[0]; //density of atmosphere at given altitude, placeh
	Variable A_drag = drag_dist_params[1]; //drag surface area
	Variable C_D_drag = drag_dist_params[2];
	
	//A_drag = some function of surface-area actually faced towards the spacecraft movement.
	Matrix v_b = AttitudeConvert(0,3,sp,sp.Velocity).ToColumnMatrix()*1e3;
	//Report v_b.Norm()^2;
	Matrix F_b_drag = -1/2*rho_drag*A_drag*((v_b.Norm(2))) * C_D_drag*v_b;
	tau_drag = (x_CP - x_CG).CrossProduct(F_b_drag);
EndProcedure;

//placeholder
Define Procedure calculate_magnetic_disturbance_torque(Spacecraft sp, Array mag_dist_params, Matrix tau_mag);
	Variable D = mag_dist_params[0];
	Matrix B_b = sp.MagneticField(3).ToColumnMatrix()*1e-9;
	Matrix D_scaling_vec = D*sqrt(1/3)*[1;1;1];
	tau_mag = D_scaling_vec.CrossProduct(B_b);
EndProcedure;

//placeholder
Define Procedure calculate_SRP_torque(Spacecraft sp, Matrix R_b_i, Array SRP_dist_params, Matrix x_CG, Matrix x_CP, Matrix tau_SRP);
	Variable F_SRP = SRP_dist_params[0]; //solar constant
	Variable c = SRP_dist_params[1]; //speed of light m/s
	Variable A_SRP = SRP_dist_params[2]; //SRP surface area. 
	Variable l = SRP_dist_params[3]; //reflectance
	Variable alpha = SRP_dist_params[4]; //incidence angle of incoming light
	
	//A_SRP = some function of actual surface faced towards the sun
	//Variable alpha = sp.ge
	Matrix F_b_SRP = R_b_i*F_SRP/c*A_SRP*(1+l)*cos(alpha)*[0;1;0];
	tau_SRP = (x_CP - x_CG).CrossProduct(F_b_SRP);
	//tau_SRP = [0;0;0];
EndProcedure;

Define Procedure get_disturbance_torques(Spacecraft sp, Array enabled_disturbances_array, Array drag_dist_params, Array mag_dist_params, Array SRP_dist_params, Matrix x_CG, Matrix x_CP, Matrix tau_d);
	Matrix tau_g = [0;0;0];
	Matrix tau_drag = [0;0;0];
	Matrix tau_mag = [0;0;0];
	Matrix tau_SRP = [0;0;0];
	
	Matrix R_b_o;
	Matrix R_o_i;
	Call get_R_b_o(sp,R_b_o);
	Call get_R_o_i(sp,R_o_i);
	Matrix R_b_i = R_b_o*R_o_i;
	
	If(enabled_disturbances_array[0]);
		Call calculate_gravity_gradient_torque(sp,R_b_o,tau_g);
	End;
	
	If(enabled_disturbances_array[1]);
		Call calculate_drag_torque(sp,drag_dist_params,x_CG,x_CP,tau_drag);
	End;
	
	If(enabled_disturbances_array[2]);
		Call calculate_magnetic_disturbance_torque(sp,mag_dist_params,tau_mag);
	End;
	
	If(enabled_disturbances_array[3]);
		Call calculate_SRP_torque(sp,R_b_i,SRP_dist_params,x_CG,x_CP,tau_SRP);
	End;
	
	tau_d = tau_g + tau_drag + tau_mag + tau_SRP;
	//Report tau_d, tau_g, tau_drag, tau_mag, tau_SRP;
EndProcedure;


Define Procedure saturation(Matrix vec, Array upper_limit, Array lower_limit);
	Variable i;
	For i=0 to vec.ColumnCount-1 step 1;
		vec[i,0] = max(vec[i,0],lower_limit[i]);
		vec[i,0] = min(vec[i,0],upper_limit[i]);
	End;
EndProcedure;

Define Procedure desired_quaternion(Spacecraft sp, Matrix targetVector_eci);
	//AttitudeConvert(0,2,sp,targetVector_eci);
	
EndProcedure;

// =============================================================================================== //
// ==                                          CONTROL                                          == //
// =============================================================================================== //

Define Procedure PD_controller(Spacecraft sp, Matrix Kp, Matrix Kd, Matrix q, Matrix omega, Matrix q_d, Matrix omega_d, Matrix tau_c);
	Matrix J = sp.MOI;
	//Matrix q = sp.Quaternion.ToColumnMatrix();
	//Call quaternion_make_scalar_first(q);
	Matrix q_d_conj = [1;0;0;0];
	Matrix q_tilde = [1;0;0;0];
	
	Call quaternion_conjugate(q_d,q_d_conj);
	Call quaternion_multiplication(q_d_conj,q,q_tilde);
	
	tau_c = -(Kp*q_tilde[1:3,0] + Kd*(omega - omega_d));
EndProcedure;

Define Procedure PD_controller_error(Spacecraft sp, Matrix Kp, Matrix Kd, Matrix q_tilde, Matrix omega, Matrix omega_d, Matrix tau_c);
	Matrix J = sp.MOI;
	//Matrix q = sp.Quaternion.ToColumnMatrix();
	//Call quaternion_make_scalar_first(q);
	//Matrix q_d_conj = [1;0;0;0];
	//Matrix q_tilde = [1;0;0;0];
	
	//Call quaternion_conjugate(q_d,q_d_conj);
	//Call quaternion_multiplication(q_d_conj,q,q_tilde);
	
	tau_c = -(Kp*q_tilde[1:3,0] + Kd*(omega - omega_d));
EndProcedure;

Define Procedure PD_sun_pointing(Spacecraft sp, Matrix Kp, Matrix Kd,Matrix q, Matrix omega, Matrix q_d, Matrix omega_d, Matrix tau_c);
	
EndProcedure;

Define Procedure rw_PI_controller(Spacecraft sp, Matrix KP_rw, Matrix KI_rw, Matrix k_t_rw, Matrix b_ws_rw, Matrix omega_rw, Matrix omega_rw_d, Matrix e_int, Matrix omega_rw_dot);
	Matrix omega_tilde_rw = omega_rw - omega_rw_d;
	
	Matrix i_rw = KP_rw*omega_tilde_rw + KI_rw*e_int;
	 // = k_t_rw*i_rw - b_ws_rw*omega_rw;
EndProcedure;

Define Procedure Magnettorquer_dipole(Spacecraft sp, Matrix tau_c, Variable dipole_saturation);
	Matrix tau_c_in = tau_c;
	Array B_b_array_i = sp.MagneticField(0)*1e-9;
	Array B_b_array = AttitudeConvert(0,3,sp,B_b_array_i);
	//Report B_b_array;
	Matrix B_b = B_b_array.ToColumnMatrix();
	
	Matrix Dipole = [0;0;0];
	Variable B_b_norm = B_b.Norm(2);
	If(B_b_norm!=0);
		Dipole = B_b.CrossProduct(tau_c_in)/(B_b_norm^2);
	End;
	Variable i;
	Variable is_saturated = 0;
	For i=0 to 3-1 step 1;
		If(abs(Dipole[i,0]) > dipole_saturation);
			Dipole[i,0] = sign(Dipole[i,0])*dipole_saturation;
			//is_saturated=1;
		End;
	End;
	/*If(is_saturated);
		Dipole = Dipole/(abs(Dipole).Max())*dipole_saturation;
	End;*/
	
	tau_c = Dipole.CrossProduct(B_b);
	//Report B_b, Dipole, tau_c_in, tau_c;
	
EndProcedure;

Define Procedure Magnettorquer_Momentum_Dumping(Spacecraft sp, Matrix omega_w_bw, Matrix omega_w_bw_d, Variable k_m, Matrix A, Matrix J_w, Matrix tau_MTQ);
	Matrix B_b = sp.MagneticField(3).ToColumnMatrix()*1e-9;
	Matrix h_b_e = A*J_w*(omega_w_bw - omega_w_bw_d);
	Matrix m_b_MTQ = k_m/(B_b.Norm(2)^2)*h_b_e.CrossProduct(B_b);
	tau_MTQ = m_b_MTQ.CrossProduct(B_b);
EndProcedure;

Define Procedure updateAttitudeDynamics_rw(Spacecraft sp, Matrix omega_b_ib, Matrix omega_rw, Matrix omega_rw_dot, Matrix tau_MTQ, Matrix tau_d, Matrix J_w, Matrix A, Matrix omega_dot);
	Matrix J = sp.MOI;
	Matrix J_inv = J.Inverse();
	Matrix S_omega_b_ib;
	Call skew_matrix(omega_b_ib,S_omega_b_ib);
	
	Matrix h_s = J_w*omega_rw;
	Matrix h_b = J*omega_b_ib + A*h_s;
	Matrix w_wheel_dot = [0;0;0];
	
	omega_dot =  J_inv*(-S_omega_b_ib*h_b - A*J_w*w_wheel_dot + tau_MTQ + tau_d);
	
EndProcedure;

Define Procedure updateAttitudeDynamics(Spacecraft sp, Matrix omega_old, Matrix omega_dot, Matrix tau_c, Matrix tau_d);
	Matrix J = sp.MOI;
	Matrix J_inv = J.Inverse();
	//tau_c = [0;0;0];
	
	omega_dot = J_inv*(-omega_old.CrossProduct(J*omega_old) + tau_c + tau_d);
EndProcedure;

/*
simple 1-euler solver
*/
Define Procedure eulerIntegration(Matrix omega_dot, Matrix omega_old, Matrix omega_new, Variable dt);
	omega_new = omega_old + omega_dot*dt;
EndProcedure;


Define Procedure quaternion_integration(Spacecraft sp, Matrix omega_b_ob, Matrix q_new, Variable dt);
	Matrix q_bo = sp.Quaternion.ToColumnMatrix();
	Call quaternion_make_scalar_first(q_bo);
	/*Variable nu = q_bo[0,0];
	Matrix eta = [q_bo[1,0];q_bo[2,0];q_bo[3,0]];
	Matrix S_eta;
	Call skew_matrix(eta,S_eta);
	
	Matrix T = [-eta.Transpose(); nu*Matrix.Identity(3) + S_eta];
	//Report T;
	Matrix q_dot = 1/2*T*omega_b_ob;*/

	//solver:
	Variable delta_nu;
	Matrix delta_eta;
	Matrix delta_q;
	
	If(omega_b_ob.Norm()==0);
		delta_q = [1;0;0;0];
	Else;
		delta_nu = cos(omega_b_ob.Norm()*dt/2);
		delta_eta = sin(omega_b_ob.Norm()*dt/2)*omega_b_ob/omega_b_ob.Norm();
		//TODO: divide by zero handling
		
		delta_q = [delta_nu;delta_eta]; 
	End;
	Call quaternion_multiplication(delta_q,q_bo,q_new);
	q_new = q_new.Normalized();
EndProcedure;

Define Procedure get_attitude_error_quaternion(Spacecraft sp, Variable sensor_id, Matrix q_tilde);
	Array sunVec_eci = sp.VectorToObject(Sun);
	//sunVec_eci = sunVec_eci.Normalized();
	Array sunVec_lvlh = AttitudeConvert(0,2,sp,sunVec_eci);
	sunVec_lvlh = sunVec_lvlh.Normalized();
	
	Array v_body = sp.Sensors[sensor_id].BoresightUnitVector;
	Array v_lvlh = AttitudeConvert(3,2,sp,v_body);
	v_lvlh = v_lvlh.Normalized();
	
	/*Matrix q = sp.Quaternion.ToColumnMatrix();
	Matrix q_conj;
	
	Call quaternion_make_scalar_first(q);
	Call quaternion_conjugate(q,q_conj);
	
	Matrix q_temp1;
	Matrix q_temp2;
	
	Call quaternion_multiplication(q,[0;v],q_temp1);
	Call quaternion_multiplication(q_temp1,q_conj,q_temp2);
	
	Matrix v_rot = q_temp2[1:3,0];
	v_rot = v_rot.Normalized();*/
	Array vec_arr;
	Matrix vec;
	Variable ang;
	Variable nu;
	Matrix eta;
	
	If(abs(v_lvlh.DotProduct(sunVec_lvlh))==0);
		q_tilde=[1;0;0;0];
	Else;
		vec_arr = -v_lvlh.CrossProduct(sunVec_lvlh);
		vec = vec_arr.ToColumnMatrix();
		
		ang = acos(v_lvlh.DotProduct(sunVec_lvlh));
		
		nu = cos(ang/2);
		eta = vec*sin(ang/2);
		
		q_tilde = [nu;eta];
	End;
	q_tilde = q_tilde.Normalized();
	
	
	//sp.
	
EndProcedure;


Define Procedure get_rotation_between_vectors(Matrix v1_in, Matrix v2_in, Matrix Rot);
	Matrix v1 = v1_in.Normalized();
	Matrix v2 = v2_in.Normalized();
	
	Matrix vec = v1.CrossProduct(v2);
	Variable s = vec.Norm(2);
	Variable c = v1.DotProduct(v2);
	
	Matrix vec2 = vec/vec.Norm(2);
	
	Variable theta = acos(c);
	Variable c2 = cos(theta);
	Variable s2 = sin(theta);
	Matrix Sv;
	Call skew_matrix(vec2,Sv);
	
	Rot = Matrix.Identity(3) + s2*Sv + Sv*Sv*(1-c2);
EndProcedure;

Define Procedure get_orthogonal_vector(Matrix v_in, Matrix v_out);
	Matrix v1  = [1,0,0;0,0,-1;0,1,0]*v_in; //R_x 90 deg
	Matrix v2  = [0,0,1;0,1,0;-1,0,0]*v_in; //R_y 90 deg
	Matrix v3  = [0,-1,0;1,0,0;0,0,1]*v_in; //R_z 90 deg
	If(v3.DotProduct(v_in)==0);
		v_out = v3;
	ElseIf(v2.DotProduct(v_in)==0);
		v_out = v2;
	Else;
		v_out = v1;
	End;
EndProcedure;

Define Procedure get_quaternion_between_vectors(Matrix v1_in, Matrix v2_in, Matrix q_bd);
	Matrix v1 = v1_in.Normalized();
	Matrix v2 = v2_in.Normalized();
	Matrix v3;
	//Matrix v0 = v1.Solve(0);
	
	Matrix vec = v1.CrossProduct(v2);
	vec = vec.Normalized();
	Variable theta = acos(v1.DotProduct(v2));
	Variable nu;
	Matrix eta;
	
	If(v1.IsEqualTo(-v2));
		Call get_orthogonal_vector(v1,v3);
		v3 = v3.Normalized();
		q_bd = [0;v3];
	Else;
		nu = cos(theta/2);
		eta = vec*sin(theta/2);
		q_bd = [nu;eta];
		If(nu<0);
			q_bd = -q_bd;
		End;
		q_bd = q_bd.Normalized();
	End;
EndProcedure;

Define Procedure set_spacecraft_attitude_quat(Spacecraft sp, Array position_eci, Array desired_side);
	Array orientation_vector;
	Matrix q_ob = [1;0;0;0];
	Matrix q_bd = [1;0;0;0];
	Matrix q_od = [1;0;0;0]; 
	
	Call get_vector_to_position(sp,position_eci,orientation_vector);
	Call get_quaternion_between_vectors(orientation_vector.ToColumnMatrix(),desired_side.ToColumnMatrix(),q_bd);
	
	q_ob = sp.Quaternion.ToColumnMatrix();
	Call quaternion_make_scalar_first(q_ob);
	Call quaternion_multiplication(q_bd,q_ob,q_od);
	//Report q_ob,q_bd,q_od;
	Call quaternion_make_scalar_last(q_od);
	
	sp.Quaternion = {q_od};
EndProcedure;

Define Procedure get_desired_spacecraft_attitude_quat(Spacecraft sp, Array position_eci, Array desired_side, Matrix q_od);
	Array orientation_vector;
	Matrix q_ob = [1;0;0;0];
	Matrix q_bd = [1;0;0;0];
	//Matrix q_od = [1;0;0;0]; 
	
	Call get_vector_to_position(sp,position_eci,orientation_vector);
	Call get_quaternion_between_vectors(orientation_vector.ToColumnMatrix(),desired_side.ToColumnMatrix(),q_bd);
	
	q_ob = sp.Quaternion.ToColumnMatrix();
	Call quaternion_make_scalar_first(q_ob);
	Call quaternion_multiplication(q_bd,q_ob,q_od);
	q_od = q_od.Normalized();
EndProcedure;

Define Procedure set_spacecraft_attitude_Rot(Spacecraft sp, Array position_eci, Array desired_side);
	Array orientation_vector;
	Matrix R_b_d;
	
	Call get_vector_to_position(sp,position_eci,orientation_vector);
	Call get_rotation_between_vectors(orientation_vector.ToColumnMatrix(),desired_side.ToColumnMatrix(),R_b_d);
	
	//Call get_R_b_o(sp, R_b_o);
	sp.AttitudeMatrix = sp.AttitudeMatrix*R_b_d;
EndProcedure;


Define Procedure ADCS_main(Spacecraft sp, List<Matrix> ADCS_matrices, List<Array> ADCS_arrays, Variable dt, Matrix omega_b_ib, Matrix q_d);
	Matrix R_b_o;
	Matrix R_o_i;
	Matrix omega_b_io;
	Matrix Kp = ADCS_matrices[0];
	Matrix Kd = ADCS_matrices[1];
	Matrix omega_d = ADCS_matrices[2];
	
	Report Kp;
	Report Kd;
	
	
	Matrix tau_c = [0;0;0];
	Matrix tau_d = [0;0;0];
	Matrix omega_b_ib_dot;
	Matrix omega_b_ib_new;
	Matrix omega_b_ob;
	//Matrix q_d = [1;0;0;0];
	
	Matrix q = sp.Quaternion.ToColumnMatrix();
	Call quaternion_make_scalar_first(q);

	Call get_R_b_o(sp,R_b_o);
	Call get_R_o_i(sp,R_o_i);

	Call get_omega_b_io(sp,omega_b_io,R_o_i,R_b_o);
	//Report omega_b_io;
	
	//Report q_tilde;
	
	//Call get_desired_spacecraft_attitude_quat(sp,
	Call PD_controller(sp,Kp,Kd,q,omega_b_ib,q_d,omega_d,tau_c);
	//Call Magnettorquer_dipole(sp, tau_c, dipole_saturation);

	//Call get_disturbance_torques(sp,enabled_disturbances_array,drag_dist_params,mag_dist_params,SRP_dist_params,x_CG_b,x_CP_b, tau_d);

	Call updateAttitudeDynamics(sp,omega_b_ib,omega_b_ib_dot,tau_c,tau_d);
	//Report omega_b_ib_dot;

	Call eulerIntegration(omega_b_ib_dot,omega_b_ib,omega_b_ib_new,dt);
	omega_b_ib = {omega_b_ib_new}.ToColumnMatrix();
	//Report omega_b_ib;

	Call get_omega_b_ob(omega_b_ib,omega_b_io,omega_b_ob);

	Call quaternion_integration(sp,omega_b_ob,q,dt);
	Call quaternion_make_scalar_last(q);
	sp.Quaternion = {q};
	//Call quaternion_make_scalar_first(q);

	//Spacecraft1.AttitudeRefFrame = "MJ2000";
	//Spacecraft1.AngularVelocity = {omega_b_ob*rad2deg}; //unused since user-defined quaternion integration is used instead.
	//Report omega_b_ib.Norm()*rad2deg;
	//Spacecraft1.AttitudeRefFrame = "LVLH";
	//Report Spacecraft1.Height;
EndProcedure;

